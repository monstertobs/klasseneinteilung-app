# Klasseneinteilung Webapp - Umgebungsvariablen
# Kopieren Sie diese Datei zu .env und passen Sie die Werte an

# Flask Secret Key (KRITISCH: Muss gesetzt werden, sonst startet die App nicht!)
# Generieren Sie einen sicheren zufälligen Key mit:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Ersetzen Sie den Platzhalter unten durch Ihren generierten Key:
SECRET_KEY=HIER-IHREN-GENERIERTEN-SECRET-KEY-EINFUEGEN

# Flask Debug Mode (nur für Entwicklung!)
FLASK_DEBUG=False

# Datenbank-Pfad
DATABASE_PATH=klasseneinteilung.db

# Session-Lebensdauer (in Stunden)
SESSION_LIFETIME=2

# Maximale Anzahl Benutzer
MAX_USERS=10

# Maximale Anzahl Schüler
MAX_STUDENTS=250
