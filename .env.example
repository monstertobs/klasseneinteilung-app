# Klasseneinteilung Webapp - Umgebungsvariablen
# Kopieren Sie diese Datei zu .env und passen Sie die Werte an

# Flask Secret Key (WICHTIG: Ändern Sie dies für Produktion!)
# Generieren Sie einen zufälligen Key mit: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# Flask Debug Mode (nur für Entwicklung!)
FLASK_DEBUG=False

# Datenbank-Pfad
DATABASE_PATH=klasseneinteilung.db

# Session-Lebensdauer (in Stunden)
SESSION_LIFETIME=2

# Maximale Anzahl Benutzer
MAX_USERS=10

# Maximale Anzahl Schüler
MAX_STUDENTS=250
